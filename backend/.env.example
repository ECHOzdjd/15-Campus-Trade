# 服务器配置
PORT=3000
NODE_ENV=development

# JWT 密钥（生产环境应使用强加密的随机字符串）
JWT_SECRET=

# MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campus_trade
DB_CONNECTION_LIMIT=10

# Redis 缓存配置（可选）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 文件上传配置
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# 日志配置
LOG_LEVEL=info

# Doubao Ark AI 配置
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-mini-260215

# CORS 配置
CORS_ORIGIN=http://localhost:5173
